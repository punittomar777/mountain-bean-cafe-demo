# Mountain Bean Café — reservation/enquiry email (Resend)
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Resend API key — https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=your_resend_api_key_here

# Verified sender. For quick testing use Resend's shared sender below (no setup):
#   EMAIL_FROM=Mountain Bean Café <onboarding@resend.dev>
# For production, verify your own domain in Resend and use an address on it, e.g.:
#   EMAIL_FROM=Mountain Bean Café <reservations@yourcafedomain.com>
EMAIL_FROM=Mountain Bean Café <onboarding@resend.dev>

# Where reservation requests are delivered — the café inbox (your inbox for testing).
EMAIL_TO=your-personal-email@example.com
